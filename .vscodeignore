# Source & build tooling (the extension ships only the esbuild bundle in dist/)
.vscode/**
.vscode-test/**
.github/**
.gitignore
.eslintignore
eslint.config.*
.eslintrc*
tsconfig.json
esbuild.js
STYLEGUIDE.md
AGENTS.md

# The language server and the CLI ship as the bundles dist/server.js and
# dist/cli.js; their sources are not read at runtime.
server/**
cli/**

# TypeScript sources and the tsc/test output are not needed at runtime: the
# extension entry point is the bundled dist/extension.js. The webview assets are
# the exception — they are read from disk at runtime, so keep src/webview/**.
src/**
!src/webview/**
out/**

# node_modules is bundled into dist/extension.js, so none of it needs shipping.
node_modules/**

# Sourcemaps and packaged artifacts.
**/*.map
*.vsix

# CLI standalone binaries are distributed separately and should not inflate the
# VS Code extension package.
dist/pgformat.exe
dist/pgformat.zip
dist/binaries/**

# The Marketplace uses the 128x128 images/icon.png; the full-resolution master
# it was scaled from stays in the repository but must not be shipped.
images/icon-source.png

